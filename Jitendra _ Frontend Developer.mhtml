.footer { padding: 25px 8%; background: rgb(15, 23, 42); color: white; display: flex; justify-content: space-between; align-items: center; gap: 20px; }

.footer p { font-size: 14px; }

.footer div { display: flex; gap: 20px; }

.footer a { color: rgb(203, 213, 225); font-size: 14px; transition: 0.3s; }

.footer a:hover { color: rgb(96, 165, 250); }

.top-btn { position: fixed; right: 25px; bottom: 25px; width: 45px; height: 45px; border: none; border-radius: 8px; background: var(--primary); color: white; font-size: 22px; cursor: pointer; display: none; align-items: center; justify-content: center; z-index: 999; box-shadow: rgba(37, 99, 235, 0.3) 0px 5px 20px; transition: 0.3s; }

.top-btn:hover { background: var(--primary-dark); transform: translateY(-3px); }

.top-btn.show { display: flex; }

.reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.7s, transform 0.7s; }

.reveal.active { opacity: 1; transform: translateY(0px); }

@media (max-width: 1000px) {
  .hero { gap: 40px; }
  .hero h1 { font-size: 48px; }
  .profile-circle { width: 280px; height: 280px; }
  .skills-grid { grid-template-columns: repeat(2, 1fr); }
  .about-container { gap: 40px; }
}

@media (max-width: 850px) {
  .nav-links { position: absolute; top: 75px; left: 0px; width: 100%; display: none; flex-direction: column; gap: 0px; padding: 10px 25px 20px; background: var(--background); border-bottom: 1px solid var(--border); box-shadow: var(--shadow); }
  .nav-links.active { display: flex; }
  .nav-links li { width: 100%; }
  .nav-links li a { display: block; padding: 13px 0px; }
  .nav-links li a::after { display: none; }
  .menu-btn { display: flex; }
  .hero { min-height: auto; padding-top: 130px; flex-direction: column-reverse; text-align: center; }
  .hero-content { max-width: 700px; }
  .hero-text { margin-left: auto; margin-right: auto; }
  .hero-buttons { justify-content: center; }
  .social-links { justify-content: center; }
  .about-container { grid-template-columns: 1fr; max-width: 700px; }
  .about-image { max-width: 500px; width: 100%; margin: auto; }
  .contact-container { grid-template-columns: 1fr; gap: 40px; }
}

@media (max-width: 600px) {
  .section { padding: 75px 5%; }
  .navbar { padding: 0px 18px; }
  .logo { font-size: 24px; }
  .hero { padding: 120px 5% 70px; }
  .hero h1 { font-size: 38px; }
  .hero h2 { font-size: 20px; }
  .hero-text { font-size: 15px; }
  .profile-circle { width: 220px; height: 220px; }
  .hero-buttons { flex-direction: column; width: 100%; max-width: 300px; margin-left: auto; margin-right: auto; }
  .btn { width: 100%; }
  .section-title { margin-bottom: 40px; }
  .section-title h2 { font-size: 30px; }
  .about-box { min-height: 250px; }
  .about-info { grid-template-columns: 1fr; }
  .about-content h3 { font-size: 25px; }
  .skills-grid { grid-template-columns: 1fr; }
  .projects-grid { grid-template-columns: 1fr; }
  .project-image { height: 160px; }
  .education-card { flex-direction: column; padding: 25px; }
  .education-card h3 { font-size: 19px; }
  .contact-form { padding: 20px; }
  .contact-info h3 { font-size: 25px; }
  .footer { flex-direction: column; text-align: center; padding: 25px 5%; }
  .footer div { justify-content: center; flex-wrap: wrap; }
  .top-btn { right: 18px; bottom: 18px; }
}

@media (max-width: 380px) {
  .hero h1 { font-size: 32px; }
  .profile-circle { width: 190px; height: 190px; }
  .section-title h2 { font-size: 27px; }
  .project-content { padding: 20px; }
}
